# Copy to .env and set the stream key. .env is gitignored.
# Restart `yarn examples:start` after changing these values.
#
# Used only when an example does not pass its own stream key or ?streamKey=.
# VITE_CONFIG_ENV is applied together with VITE_STREAM_KEY.
# Intended for a platdev key that allows property metadata and does not allow measurement.

VITE_CONFIG_ENV=platdev
VITE_STREAM_KEY=
