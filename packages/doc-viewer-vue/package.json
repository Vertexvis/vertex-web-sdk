{
  "name": "@vertexvis/doc-viewer-vue",
  "version": "1.1.0",
  "description": "Vue bindings for the Vertex Document Viewer SDK.",
  "license": "MIT",
  "author": "Vertex Developers <support@vertex3d.com> (https://developer.vertex3d.com)",
  "homepage": "https://github.com/Vertexvis/vertex-web-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vertexvis/vertex-web-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Vertexvis/vertex-web-sdk/issues"
  },
  "type": "module",
  "main": "./dist/bundle.cjs",
  "module": "./dist/bundle.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bundle.js",
      "require": "./dist/bundle.cjs",
      "default": "./dist/bundle.js"
    }
  },
  "files": [
    "dist/*"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "clean": "rm -fr ./dist && mkdir ./dist",
    "prebuild": "yarn clean",
    "build": "rollup --config rollup.config.js",
    "format": "yarn lint --fix",
    "lint": "eslint .",
    "test": "echo 'No unit tests defined'",
    "test:ci": "yarn test:coverage",
    "test:coverage": "echo 'No unit tests defined'"
  },
  "dependencies": {
    "@stencil/vue-output-target": "^0.14.1",
    "@vertexvis/doc-viewer": "1.1.0"
  },
  "devDependencies": {
    "@vertexvis/eslint-config-vertexvis-typescript": "^0.6.2",
    "@vertexwebsdk/build": "1.1.0",
    "eslint": "^8.57.1",
    "rollup": "^4.62.4",
    "tslib": "^2.8.1",
    "vue": "^3.5.41"
  },
  "peerDependencies": {
    "tslib": ">=2.4.0"
  }
}
