{
  "$schema": "http://json.schemastore.org/tsconfig",
  "extends": "@vertexwebsdk/build/tsconfig-web",
  "compilerOptions": {
    "inlineSources": false,
    "experimentalDecorators": true,
    "jsx": "react",
    "jsxFactory": "h",
    "target": "ES2019",
    "baseUrl": ".",
    "paths": {
      "#test/mock-types": ["../../vitest.mock-types.ts"],
      "#test/render-spec-page": ["../../vitest.render-spec-page.ts"]
    }
  },
  "include": [
    "src",
    "types/*.d.ts",
    "src/components.d.ts",
    "src/regl-shape.d.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
