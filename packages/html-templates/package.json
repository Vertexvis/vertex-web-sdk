{
  "name": "@vertexvis/html-templates",
  "version": "1.1.1",
  "description": "HTML templating library for Viewer SDK.",
  "license": "MIT",
  "author": "Vertex Developers <support@vertex3d.com> (https://developer.vertex3d.com)",
  "homepage": "https://github.com/Vertexvis/vertex-web-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vertexvis/vertex-web-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Vertexvis/vertex-web-sdk/issues"
  },
  "type": "module",
  "main": "./dist/bundle.cjs",
  "module": "./dist/bundle.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/bundle.js",
      "require": "./dist/bundle.cjs",
      "default": "./dist/bundle.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist/*",
    "!dist/**/__tests__"
  ],
  "scripts": {
    "clean": "rm -fr ./dist && mkdir ./dist",
    "prebuild": "yarn clean",
    "build": "rollup --config ./rollup.config.js",
    "format": "yarn lint --fix",
    "lint": "eslint .",
    "start": "yarn test:watch",
    "test": "vitest run",
    "test:ci": "yarn test:coverage",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@vertexvis/utils": "1.1.1"
  },
  "devDependencies": {
    "@vertexvis/eslint-config-vertexvis-typescript": "^0.6.2",
    "@vertexwebsdk/build": "1.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^10.11.0",
    "rollup": "^4.63.5",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "tslib": ">=2.4.0"
  }
}
