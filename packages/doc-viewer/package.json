{
  "name": "@vertexvis/doc-viewer",
  "version": "1.1.0",
  "description": "The Vertex SDK for viewing documents.",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/doc-viewer/doc-viewer.esm.js",
  "license": "MIT",
  "author": "Vertex Developers <support@vertex3d.com> (https://developer.vertex3d.com)",
  "homepage": "https://github.com/Vertexvis/vertex-web-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vertexvis/vertex-web-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/Vertexvis/vertex-web-sdk/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/index.cjs",
      "default": "./dist/esm/index.mjs"
    },
    "./doc-viewer.css": "./dist/doc-viewer/doc-viewer.css",
    "./dist/*": "./dist/*",
    "./dist/components": {
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./dist/components/*": {
      "import": "./dist/components/*",
      "default": "./dist/components/*"
    },
    "./loader/*": "./loader/*",
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "default": "./loader/index.js"
    },
    "./assets/*": "./assets/*",
    "./assets/pdf.worker.min.mjs": {
      "import": "./assets/pdf.worker.min.mjs",
      "default": "./assets/pdf.worker.min.mjs"
    },
    "./dist/doc-viewer/doc-viewer.css": {
      "default": "./dist/doc-viewer/doc-viewer.css"
    }
  },
  "files": [
    "assets/",
    "dist/",
    "loader/",
    "LICENSE"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "prebuild": "mkdir -p assets && cp ../../node_modules/pdfjs-dist/build/pdf.worker.min.mjs ./assets",
    "build": "stencil build",
    "postbuild": "./scripts/postbuild.sh",
    "prestart": "mkdir -p assets && cp ../../node_modules/pdfjs-dist/build/pdf.worker.min.mjs ./assets",
    "start": "stencil build --dev --watch --serve",
    "dev": "yarn start",
    "format": "yarn lint --fix",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ssr-import": "node ./scripts/test-ssr-import.mjs",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "test:coverage": "vitest run --coverage",
    "generate": "stencil generate",
    "generate:docs": "../../scripts/generate_docs.sh",
    "release:stage": "yarn generate:docs"
  },
  "devDependencies": {
    "@stencil/core": "^4.43.5",
    "@stencil/react-output-target": "^1.6.2",
    "@stencil/vitest": "1.15.1",
    "@stencil/vue-output-target": "^0.14.1",
    "@types/node": "^22.20.4",
    "@vertexvis/eslint-config-vertexvis-typescript": "^0.6.2",
    "eslint": "^9.39.5",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@vertexvis/geometry": "1.1.0",
    "@vertexvis/utils": "1.1.0",
    "classnames": "^2.5.1",
    "pdfjs-dist": "^5.7.284",
    "resize-observer": "^1.0.4"
  }
}
