{
  "name": "root",
  "private": true,
  "nextVersionBump": "patch",
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^10.13.0",
    "happy-dom": "20.14.6",
    "lerna": "^10.1.1",
    "prettier": "^3.9.10",
    "rollup": "^4.64.7",
    "semver": "^7.8.5",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "4.1.12"
  },
  "scripts": {
    "postinstall": "yarn generate:vscode-workspace && yarn generate:npmrc",
    "generate:vscode-workspace": "./scripts/generate_vscode_workspace.sh",
    "generate:docs": "lerna run generate:docs && typedoc --tsconfig tsconfig.docs.json",
    "generate:npmrc": "./scripts/generate_npmrc.sh",
    "build": "lerna run build",
    "release": "./scripts/release.sh",
    "release:ask": "ASK_VERSION=true ./scripts/release.sh",
    "test": "lerna run test",
    "test:ci": "lerna run test:ci",
    "test:coverage": "lerna run test:coverage",
    "typecheck:spec": "tsc -p tsconfig.spec.json",
    "lint": "lerna run lint",
    "format:prettier": "prettier --write --list-different .",
    "format": "lerna run format && yarn format:prettier",
    "clean": "lerna clean",
    "validate": "yarn build && yarn test && yarn lint",
    "version:bump": "./scripts/version_bump.sh",
    "examples:start": "vite --host 0.0.0.0 --port 8088 --strictPort"
  },
  "workspaces": {
    "packages": [
      "internal/*",
      "packages/*"
    ],
    "nohoist": [
      "**/@stencil/react-output-target",
      "**/@stencil/react-output-target/**",
      "**/@stencil/vue-output-target",
      "**/@stencil/vue-output-target/**"
    ]
  },
  "resolutions": {
    "protobufjs": "^7.6.6",
    "semver": "^7.8.4"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "yarn@4.18.1"
}
